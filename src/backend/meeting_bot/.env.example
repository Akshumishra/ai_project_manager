# ──────────────────────────────────────────────────────────────────────────────
# Google Meet Bot — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Google Account ─────────────────────────────────────────────────────────────
# The Gmail account that the bot will use to join meetings.
GOOGLE_EMAIL=you@gmail.com

# Password is only needed for the one-time `seed-login` command.
# After seeding, cookies are persisted and this can be left blank.
GOOGLE_PASSWORD=your-password-here

# ── Browser Profile ────────────────────────────────────────────────────────────
# Persistent Chromium profile directory (stores cookies across runs).
# Default: ~/.meet_bot_profile
BROWSER_PROFILE_DIR=

# ── Recordings ─────────────────────────────────────────────────────────────────
# Directory where .wav output files will be written.
# Default: ./recordings  (relative to the working directory)
RECORDINGS_DIR=./recordings

# ── Audio Capture ──────────────────────────────────────────────────────────────
# The ffmpeg audio input device name (avfoundation on macOS).
# Run `ffmpeg -f avfoundation -list_devices true -i ""` to see available devices.
# For BlackHole 2ch this is typically "BlackHole 2ch".
AUDIO_DEVICE=BlackHole 2ch

# ── Bot Display Name ───────────────────────────────────────────────────────────
# The name shown in Google Meet when the bot joins.
BOT_DISPLAY_NAME=Meeting Bot

# ── Performance & Concurrency ──────────────────────────────────────────────────
# Use headless mode to save resources (browser window is hidden).
# Default: true
HEADLESS=true

# Reserved for future orchestrator scaling limits.
MAX_CONCURRENT_SESSIONS=5
